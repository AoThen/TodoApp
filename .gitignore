# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
node_modules/
# Go 编译产物（不应纳入版本库；根锚定避免误伤 android 源码包路径）
/todoapp-server
/todoapp
/test-build
# 本地 SQLite 数据库文件
*.db
*.db-shm
*.db-wal
# 本地环境变量文件（.env.docker / .env.example 为模板，保持跟踪）
.env
.env.local

